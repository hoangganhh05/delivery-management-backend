MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_DATABASE=delivery_db
MYSQL_USER=delivery_user
MYSQL_PASSWORD=replace_with_a_strong_database_password

SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/database?sslMode=REQUIRED&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=database_user
SPRING_DATASOURCE_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,https://your-frontend.example.com
# Optional only when enabling the legacy VNPay endpoint.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
# Leave QR transfer settings blank. They are retained only for historical VCB_QR orders.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
# Required before allowing customers to save payout accounts. Generate a Base64 32-byte value and keep it secret.
BANK_ACCOUNT_ENCRYPTION_KEY=
SEED_VOUCHERS=false

# One-time Admin bootstrap. Password: 8+ characters, one uppercase and one special character.
# Disable BOOTSTRAP_ADMIN_ENABLED again after the account has been created.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Replace_With_A_Strong_Password
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
# Set true only when intentionally resetting an existing account password.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
